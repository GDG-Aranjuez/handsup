# Firebase web app config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to true to talk to the local emulators (firebase/ → pnpm emulators)
VITE_USE_EMULATOR=false
# Event opened from the home page. Leave empty to show the join-by-code screen only.
VITE_DEFAULT_EVENT=
